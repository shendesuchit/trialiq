# ============================================================
# TrialIQ repository exclusions
# ============================================================

# Secrets / local environment
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python generated artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Python/package builds
build/
dist/
site/

# Node / Vite / TypeScript
node_modules/
frontend/node_modules/
.vite/
frontend/.vite/
frontend/dist/
dist-ssr/
*.tsbuildinfo

# Logs
logs/
*.log
*.pid

# Temporary patch / merge files
*.patch
*.rej
*.orig

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temporary/cache
*.tmp
*.temp
.cache/
tmp/
temp/

# Local database storage
neo4j-data/
neo4j-logs/
postgres-data/

# Large source/database archives
*.dump
*.backup
*.tar.gz
*.zip

# Pytest temporary working files
.pytest-tmp/

# Generated inspection/concatenation bundles
combined_files*.txt
*inspection_bundle*.txt
