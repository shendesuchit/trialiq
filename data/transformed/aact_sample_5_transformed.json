    {
      "key": "eligibilities:NCT00000105:234855577",
      "label": "Eligibility",
      "properties": {
        "source_table": "eligibilities",
        "source_id": 234855577,
        "nct_id": "NCT00000105",
        "id": 234855577,
        "sampling_method": "PROBABILITY_SAMPLE",
        "gender": "ALL",
        "minimum_age": "18 Years",
        "maximum_age": null,
        "healthy_volunteers": true,
        "population": "* Normal volunteers\n* Patients with Cancer (breast, melanoma, hematologic)\n* Transplant patients (umbilical cord blood transplant, autologous transplant)\n* Patients receiving other cancer vaccines",
        "criteria": "Inclusion Criteria:\n\n* Patients must have a diagnosis of cancer of any histologic type.\n* Patients must have a Karnofsky performance status great or equal to 70%.\n* Patients must have an expected survival for at least four months.\n* Normal healthy volunteers to serve as control for this study.\n* All patients must sign informed consent approved by the Committee on the Use of Human Subjects at the University of Minnesota\n\nExclusion Criteria:\n\n* Pregnant or lactating women. Females of child-bearing potential will be asked to take a pregnancy test before receiving vaccines.\n* Serious intercurrent medical illnesses which would interfere with the ability of the patient to carry out the follow-up monitoring program.\n* Immunization should not be administered during the course of any febrile illness or acute infection.\n* Hypersensitivity to any component of the vaccine, including Thimerosal, a mercury derivative.\n* The occurrence of any type of neurologic symptoms to tetanus vaccine in th past.\n* Patients with a history of seafood allergy are excluded from receiving KLH.\n* Subjects who have had tetanus toxoid within the last 7 years are not eligible for tetanus vaccine component of this protocol.",
        "gender_description": null,
        "gender_based": null,
        "adult": true,
        "child": false,
        "older_adult": true
      }
    },
    {
      "key": "eligibilities:NCT00000106:234958792",
      "label": "Eligibility",
      "properties": {
        "source_table": "eligibilities",
        "source_id": 234958792,
        "nct_id": "NCT00000106",
        "id": 234958792,
        "sampling_method": null,
        "gender": "ALL",
        "minimum_age": "18 Years",
        "maximum_age": "65 Years",
        "healthy_volunteers": false,
        "population": null,
        "criteria": "Inclusion Criteria:\n\n* Patients are required to meet the criteria of the American College of Rheumatology (ACR)for rheumatoid arthritis.\n* Patients should be in functional class II, or III according to the criteria of the ACR.\n* All candidates must be unsuccessfully treated (lack of efficacy) with at least two of the following disease-modifying antirheumatic drugs: hydroxychloroquinine, oral or injectable gold, methotrexate, azathioprine, penicillamine, and sulfasalazine.\n* Patients receiving nonsteroidal antiinflammatory drugs (NSAIDs), corticosteroids (\\<= 10 mg per day), or both are eligible if the dosage has been stable for at least four weeks before treatment and remained so throughout the study and follow-up period (the use of narcotics for pain flares is allowed).\n* The necessary degree of disease activity at enrollment should be confirmed by a finding of 10 or more swollen joints, 12 or more tender joints, and one of the following two criteria: a Westergren erythrocyte sedimentation rate of at least 28 mm per hour or a serum C-reactive protein level of more than 2.0 mg per deciliter; or morning stiffness for at least 60 minutes.\n* Patients must have adequate bone marrow function, adequate liver function, adequate renal function, calcium and electrolytes.\n* Patients must have a dobutamine stress ECHO, or exercise cardiac MUGA, or exercise ECHO scan prior to entry and must fulfill certain criteria to be eligible. The spirit of the criteria are to rule out organic heart disease.\n* Respiratory status: Patients who have FEV1 of \\>= 60% of predicted, as well as a maximum voluntary volume (MVV) of \\>= 60% of predicted, and blood gases with a PO2 of \\>= 60 or oxygen saturation of \\>= 90% are eligible.",
        "gender_description": null,
        "gender_based": null,
        "adult": true,
        "child": false,
        "older_adult": true
      }
    },
